{
  "name": "@dsh-external/dsh-vision",
  "version": "0.1.0",
  "description": "DSH Desktop 内置识图插件：为纯文本 DeepSeek 提供 view_image 工具，通过任意 OpenAI 兼容 VLM 端点回答图片问题（默认智谱免费 glm-4.6v-flash，可换通义 qwen3-vl / Ollama 本地 / DeepSeek 官方识图 API）。",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dsh.plugin.json"
  ],
  "license": "BSD-3-Clause",
  "engines": {
    "dsh": ">=0.0.1"
  },
  "dshx": {
    "contributes": {
      "tools": [
        "view_image"
      ],
      "skills": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-system-prompt": "^0.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1",
    "cordis": "^4.0.0-rc.7"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  }
}
