{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗/浮窗/宠物窗的桥通道权限。远程 origin 放行仅限 127.0.0.1（内核 Web UI 与 PoC 页）；桥 command 经 permissions/bridge.toml 的自定义权限放行；拖拽需要 start-dragging。",
  "windows": ["main", "float", "pet", "sponsor"],
  "remote": {
    "urls": ["http://127.0.0.1"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-internal-toggle-maximize",
    "bridge-phase1"
  ]
}
