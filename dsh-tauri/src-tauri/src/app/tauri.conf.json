{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "version": "0.5.2",
  "identifier": "com.deepseek.dsh.desktop",
  "build": {
    "frontendDist": "../../../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../../sidecar/": "sidecar/",
      "../../../ui/": "ui/",
      "../../../package-payload/dsh-desktop/": "dsh-desktop/"
    },
    "externalBin": [],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/installerHooks.nsh",
        "template": "nsis/installer-template.nsi"
      }
    }
  }
}
